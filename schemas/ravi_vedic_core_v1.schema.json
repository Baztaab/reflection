{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baztaab/reflection/schemas/ravi_vedic_core_v1.schema.json",
  "title": "RAVI VEDIC executable core v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canon_id",
    "calculation_status",
    "diagnostics",
    "input",
    "time_context",
    "provenance",
    "astronomy",
    "charts"
  ],
  "properties": {
    "schema_version": {
      "const": "ravi-vedic-core-v1"
    },
    "canon_id": {
      "const": "ravi-vedic-mvp-v1"
    },
    "input": {
      "$ref": "#/$defs/birthInput"
    },
    "time_context": {
      "$ref": "#/$defs/timeContext"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "astronomy": {
      "$ref": "#/$defs/astronomy"
    },
    "charts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "D1",
        "D9",
        "D10"
      ],
      "properties": {
        "D1": {
          "$ref": "#/$defs/d1Chart"
        },
        "D9": {
          "$ref": "#/$defs/vargaChart"
        },
        "D10": {
          "$ref": "#/$defs/vargaChart"
        }
      }
    },
    "calculation_status": {
      "enum": [
        "canonical",
        "development",
        "degraded"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "bodyName": {
      "enum": [
        "Sun",
        "Moon",
        "Mars",
        "Mercury",
        "Jupiter",
        "Venus",
        "Saturn",
        "Rahu",
        "Ketu"
      ]
    },
    "signName": {
      "enum": [
        "Aries",
        "Taurus",
        "Gemini",
        "Cancer",
        "Leo",
        "Virgo",
        "Libra",
        "Scorpio",
        "Sagittarius",
        "Capricorn",
        "Aquarius",
        "Pisces"
      ]
    },
    "longitude": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "degreeInSign": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 30
    },
    "house": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "birthInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_datetime",
        "timezone_id",
        "latitude_deg",
        "longitude_deg",
        "elevation_m",
        "calendar",
        "time_uncertainty_seconds",
        "fold",
        "source_note"
      ],
      "properties": {
        "local_datetime": {
          "type": "string"
        },
        "timezone_id": {
          "type": "string",
          "minLength": 1
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "exclusiveMaximum": 180
        },
        "elevation_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "calendar": {
          "const": "gregorian"
        },
        "time_uncertainty_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "fold": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            0,
            1,
            null
          ]
        },
        "source_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_datetime",
        "timezone_id",
        "fold",
        "utc_offset_seconds",
        "utc_datetime",
        "jd_ut",
        "jd_tt",
        "delta_t_seconds",
        "tzdb_provider",
        "tzdb_version",
        "resolution_status"
      ],
      "properties": {
        "local_datetime": {
          "type": "string"
        },
        "timezone_id": {
          "type": "string"
        },
        "fold": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "utc_offset_seconds": {
          "type": "integer"
        },
        "utc_datetime": {
          "type": "string"
        },
        "jd_ut": {
          "type": "number"
        },
        "jd_tt": {
          "type": "number"
        },
        "delta_t_seconds": {
          "type": "number"
        },
        "tzdb_provider": {
          "const": "python-tzdata"
        },
        "tzdb_version": {
          "type": "string",
          "minLength": 1
        },
        "resolution_status": {
          "enum": [
            "exact",
            "ambiguous_resolved"
          ]
        }
      }
    },
    "astronomyProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "implementation_version",
        "library_version",
        "ephemeris_path",
        "ephemeris_manifest_sha256",
        "ephemeris_file_count",
        "requested_flags",
        "sidereal_mode",
        "ayanamsha_policy_id",
        "source_profile",
        "actual_sources"
      ],
      "properties": {
        "implementation": {
          "const": "pyswisseph"
        },
        "implementation_version": {
          "type": "string"
        },
        "library_version": {
          "type": "string"
        },
        "ephemeris_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "ephemeris_manifest_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "ephemeris_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "requested_flags": {
          "type": "integer"
        },
        "sidereal_mode": {
          "const": "SIDM_TRUE_PUSHYA"
        },
        "ayanamsha_policy_id": {
          "const": "ayanamsha.true-pushya.swiss-v1"
        },
        "source_profile": {
          "enum": [
            "canonical-strict-swiss-files",
            "development-allow-moshier"
          ]
        },
        "actual_sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_profile": {
                "const": "canonical-strict-swiss-files"
              }
            }
          },
          "then": {
            "properties": {
              "ephemeris_path": {
                "type": "string",
                "minLength": 1
              },
              "ephemeris_manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "ephemeris_file_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_sha256",
        "calculation_fingerprint",
        "calculation_fingerprint_version",
        "policy_manifest_sha256",
        "runtime",
        "astronomy"
      ],
      "properties": {
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "calculation_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "calculation_fingerprint_version": {
          "const": "ravi-vedic-calculation-fingerprint-v1"
        },
        "policy_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "$ref": "#/$defs/runtimeIdentity"
        },
        "astronomy": {
          "$ref": "#/$defs/astronomyProvenance"
        }
      }
    },
    "astronomyBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "tropical_longitude_deg",
        "sidereal_longitude_deg",
        "latitude_deg",
        "distance_au",
        "longitude_speed_deg_per_day",
        "retrograde",
        "source_method"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/bodyName"
        },
        "tropical_longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "sidereal_longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "latitude_deg": {
          "type": "number"
        },
        "distance_au": {
          "type": "number"
        },
        "longitude_speed_deg_per_day": {
          "type": "number"
        },
        "retrograde": {
          "type": "boolean"
        },
        "source_method": {
          "type": "string"
        }
      }
    },
    "astronomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ayanamsha_deg",
        "ascendant",
        "bodies"
      ],
      "properties": {
        "ayanamsha_deg": {
          "type": "number"
        },
        "ascendant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tropical_longitude_deg",
            "sidereal_longitude_deg",
            "source_method"
          ],
          "properties": {
            "tropical_longitude_deg": {
              "$ref": "#/$defs/longitude"
            },
            "sidereal_longitude_deg": {
              "$ref": "#/$defs/longitude"
            },
            "source_method": {
              "type": "string"
            }
          }
        },
        "bodies": {
          "items": {
            "$ref": "#/$defs/astronomyBody"
          },
          "$ref": "#/$defs/exactGrahaArray"
        }
      }
    },
    "d1Placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "sidereal_longitude_deg",
        "sign_index",
        "sign",
        "degree_in_sign",
        "house",
        "retrograde",
        "mapping_policy_id"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/bodyName"
        },
        "sidereal_longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "sign_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "sign": {
          "$ref": "#/$defs/signName"
        },
        "degree_in_sign": {
          "$ref": "#/$defs/degreeInSign"
        },
        "house": {
          "$ref": "#/$defs/house"
        },
        "retrograde": {
          "type": "boolean"
        },
        "mapping_policy_id": {
          "const": "varga.rasi-v1"
        }
      }
    },
    "d1Chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "varga",
        "mapping_policy_id",
        "house_policy_id",
        "ascendant",
        "grahas"
      ],
      "properties": {
        "varga": {
          "const": "D1"
        },
        "mapping_policy_id": {
          "const": "varga.rasi-v1"
        },
        "house_policy_id": {
          "const": "houses.whole-sign-v1"
        },
        "ascendant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sidereal_longitude_deg",
            "sign_index",
            "sign",
            "degree_in_sign"
          ],
          "properties": {
            "sidereal_longitude_deg": {
              "$ref": "#/$defs/longitude"
            },
            "sign_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            },
            "sign": {
              "$ref": "#/$defs/signName"
            },
            "degree_in_sign": {
              "$ref": "#/$defs/degreeInSign"
            }
          }
        },
        "grahas": {
          "items": {
            "$ref": "#/$defs/d1Placement"
          },
          "$ref": "#/$defs/exactGrahaArray"
        }
      }
    },
    "vargaProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_longitude_deg",
        "segment_index",
        "target_sign_index",
        "target_sign",
        "longitude_within_target_sign_deg",
        "projected_longitude_deg",
        "mapping_policy_id"
      ],
      "properties": {
        "source_longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0
        },
        "target_sign_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "target_sign": {
          "$ref": "#/$defs/signName"
        },
        "longitude_within_target_sign_deg": {
          "$ref": "#/$defs/degreeInSign"
        },
        "projected_longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "mapping_policy_id": {
          "type": "string"
        }
      }
    },
    "vargaGraha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "source_longitude_deg",
        "segment_index",
        "target_sign_index",
        "target_sign",
        "longitude_within_target_sign_deg",
        "projected_longitude_deg",
        "mapping_policy_id",
        "house",
        "retrograde"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/bodyName"
        },
        "source_longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0
        },
        "target_sign_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "target_sign": {
          "$ref": "#/$defs/signName"
        },
        "longitude_within_target_sign_deg": {
          "$ref": "#/$defs/degreeInSign"
        },
        "projected_longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "mapping_policy_id": {
          "type": "string"
        },
        "house": {
          "$ref": "#/$defs/house"
        },
        "retrograde": {
          "type": "boolean"
        }
      }
    },
    "vargaChart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "varga",
        "factor",
        "mapping_policy_id",
        "ascendant",
        "grahas"
      ],
      "properties": {
        "varga": {
          "enum": [
            "D9",
            "D10"
          ]
        },
        "factor": {
          "enum": [
            9,
            10
          ]
        },
        "mapping_policy_id": {
          "enum": [
            "varga.parasari-navamsa-v1",
            "varga.parasari-dashamsa-v1"
          ]
        },
        "ascendant": {
          "$ref": "#/$defs/vargaProjection"
        },
        "grahas": {
          "items": {
            "$ref": "#/$defs/vargaGraha"
          },
          "$ref": "#/$defs/exactGrahaArray"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "layer",
        "affected_fields",
        "canonicality_impact",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "layer": {
          "enum": [
            "input",
            "time",
            "runtime",
            "astronomy",
            "policy",
            "projection"
          ]
        },
        "affected_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "canonicality_impact": {
          "enum": [
            "none",
            "development",
            "degraded"
          ]
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ravi",
        "python",
        "astronomy",
        "timezone",
        "source_profile"
      ],
      "properties": {
        "ravi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "distribution_name",
            "package_version",
            "source_sha256"
          ],
          "properties": {
            "distribution_name": {
              "const": "ravi-vedic"
            },
            "package_version": {
              "type": "string",
              "minLength": 1
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "version",
            "system",
            "machine"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "system": {
              "type": "string",
              "minLength": 1
            },
            "machine": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "astronomy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "binding_version",
            "library_version",
            "ephemeris_manifest_sha256",
            "ephemeris_file_count"
          ],
          "properties": {
            "implementation": {
              "const": "pyswisseph"
            },
            "binding_version": {
              "type": "string",
              "minLength": 1
            },
            "library_version": {
              "type": "string",
              "minLength": 1
            },
            "ephemeris_manifest_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "ephemeris_file_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "timezone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "version"
          ],
          "properties": {
            "provider": {
              "const": "python-tzdata"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_profile": {
          "enum": [
            "canonical-strict-swiss-files",
            "development-allow-moshier"
          ]
        }
      }
    },
    "exactGrahaArray": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "body": {
                "const": "Sun"
              }
            },
            "required": [
              "body"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "body": {
                "const": "Moon"
              }
            },
            "required": [
              "body"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "body": {
                "const": "Mars"
              }
            },
            "required": [
              "body"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "body": {
                "const": "Mercury"
              }
            },
            "required": [
              "body"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "body": {
                "const": "Jupiter"
              }
            },
            "required": [
              "body"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "body": {
                "const": "Venus"
              }
            },
            "required": [
              "body"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "body": {
                "const": "Saturn"
              }
            },
            "required": [
              "body"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "body": {
                "const": "Rahu"
              }
            },
            "required": [
              "body"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "body": {
                "const": "Ketu"
              }
            },
            "required": [
              "body"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "runtime": {
                "properties": {
                  "source_profile": {
                    "const": "development-allow-moshier"
                  }
                },
                "required": [
                  "source_profile"
                ]
              }
            },
            "required": [
              "runtime"
            ]
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "properties": {
          "calculation_status": {
            "enum": [
              "development",
              "degraded"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculation_status": {
            "const": "canonical"
          }
        },
        "required": [
          "calculation_status"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "runtime": {
                "properties": {
                  "source_profile": {
                    "const": "canonical-strict-swiss-files"
                  }
                },
                "required": [
                  "source_profile"
                ]
              }
            },
            "required": [
              "runtime"
            ]
          }
        }
      }
    }
  ]
}
