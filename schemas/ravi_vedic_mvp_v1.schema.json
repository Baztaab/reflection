{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baztaab/reflection/schemas/ravi_vedic_mvp_v1.schema.json",
  "title": "RAVI VEDIC MVP v1 result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input",
    "time_context",
    "provenance",
    "astronomy",
    "charts",
    "reference_frames",
    "networks",
    "relationships",
    "timing",
    "patterns",
    "evidence",
    "sensitivity_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0-draft.1"
    },
    "input": {
      "$ref": "#/$defs/birthInput"
    },
    "time_context": {
      "$ref": "#/$defs/timeContext"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "astronomy": {
      "$ref": "#/$defs/astronomy"
    },
    "charts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "D1",
        "D9",
        "D10"
      ],
      "properties": {
        "D1": {
          "$ref": "#/$defs/d1Chart"
        },
        "D9": {
          "$ref": "#/$defs/vargaChart"
        },
        "D10": {
          "$ref": "#/$defs/vargaChart"
        }
      }
    },
    "reference_frames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moon_lagna",
        "arudha_lagna"
      ],
      "properties": {
        "moon_lagna": {
          "$ref": "#/$defs/moonLagna"
        },
        "arudha_lagna": {
          "$ref": "#/$defs/arudhaLagna"
        }
      }
    },
    "networks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispositors"
      ],
      "properties": {
        "dispositors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dispositorPath"
          }
        }
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conjunctions",
        "aspects",
        "exchanges"
      ],
      "properties": {
        "conjunctions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conjunction"
          }
        },
        "aspects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aspect"
          }
        },
        "exchanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exchange"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vimshottari"
      ],
      "properties": {
        "vimshottari": {
          "$ref": "#/$defs/vimshottari"
        }
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pattern"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "sensitivity_summary": {
      "$ref": "#/$defs/sensitivitySummary"
    }
  },
  "$defs": {
    "bodyName": {
      "enum": [
        "Sun",
        "Moon",
        "Mars",
        "Mercury",
        "Jupiter",
        "Venus",
        "Saturn",
        "Rahu",
        "Ketu"
      ]
    },
    "classicalBodyName": {
      "enum": [
        "Sun",
        "Moon",
        "Mars",
        "Mercury",
        "Jupiter",
        "Venus",
        "Saturn"
      ]
    },
    "sign": {
      "enum": [
        "Aries",
        "Taurus",
        "Gemini",
        "Cancer",
        "Leo",
        "Virgo",
        "Libra",
        "Scorpio",
        "Sagittarius",
        "Capricorn",
        "Aquarius",
        "Pisces"
      ]
    },
    "longitude": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "degreeInSign": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 30
    },
    "house": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "sensitivity": {
      "enum": [
        "STABLE",
        "SENSITIVE",
        "UNSTABLE"
      ]
    },
    "birthInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_datetime",
        "timezone_id",
        "latitude_deg",
        "longitude_deg",
        "calendar",
        "time_uncertainty_seconds"
      ],
      "properties": {
        "local_datetime": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"
        },
        "timezone_id": {
          "type": "string",
          "minLength": 1
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "exclusiveMaximum": 180
        },
        "elevation_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "calendar": {
          "const": "gregorian"
        },
        "time_uncertainty_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "fold": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            0,
            1,
            null
          ]
        },
        "source_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_datetime",
        "timezone_id",
        "fold",
        "utc_offset_seconds",
        "utc_datetime",
        "jd_ut",
        "jd_tt",
        "delta_t_seconds",
        "tzdb_provider",
        "tzdb_version",
        "resolution_status"
      ],
      "properties": {
        "local_datetime": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"
        },
        "timezone_id": {
          "type": "string"
        },
        "fold": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            0,
            1,
            null
          ]
        },
        "utc_offset_seconds": {
          "type": "integer"
        },
        "utc_datetime": {
          "type": "string",
          "format": "date-time"
        },
        "jd_ut": {
          "type": "number"
        },
        "jd_tt": {
          "type": "number"
        },
        "delta_t_seconds": {
          "type": "number"
        },
        "tzdb_provider": {
          "type": "string"
        },
        "tzdb_version": {
          "type": "string"
        },
        "resolution_status": {
          "enum": [
            "exact",
            "ambiguous_resolved"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "engine",
        "specification_id",
        "policies",
        "dependencies",
        "data",
        "calculation",
        "warnings"
      ],
      "properties": {
        "engine": {
          "type": "object",
          "required": [
            "name",
            "version",
            "git_commit"
          ],
          "properties": {
            "name": {
              "const": "reflection"
            },
            "version": {
              "type": "string"
            },
            "git_commit": {
              "type": "string"
            }
          }
        },
        "specification_id": {
          "const": "ravi-vedic-mvp-v1"
        },
        "policies": {
          "type": "object"
        },
        "dependencies": {
          "type": "object"
        },
        "data": {
          "type": "object"
        },
        "calculation": {
          "type": "object",
          "required": [
            "generated_at_utc",
            "deterministic_input_hash"
          ],
          "properties": {
            "generated_at_utc": {
              "type": "string",
              "format": "date-time"
            },
            "deterministic_input_hash": {
              "type": "string"
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "astronomyBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "tropical_longitude_deg",
        "sidereal_longitude_deg",
        "latitude_deg",
        "distance_au",
        "longitude_speed_deg_per_day",
        "retrograde"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/bodyName"
        },
        "tropical_longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "sidereal_longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "latitude_deg": {
          "type": "number"
        },
        "distance_au": {
          "type": [
            "number",
            "null"
          ]
        },
        "longitude_speed_deg_per_day": {
          "type": "number"
        },
        "retrograde": {
          "type": "boolean"
        },
        "derived": {
          "type": "boolean"
        }
      }
    },
    "astronomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ayanamsha_deg",
        "ascendant_tropical_deg",
        "ascendant_sidereal_deg",
        "bodies"
      ],
      "properties": {
        "ayanamsha_deg": {
          "type": "number"
        },
        "ascendant_tropical_deg": {
          "$ref": "#/$defs/longitude"
        },
        "ascendant_sidereal_deg": {
          "$ref": "#/$defs/longitude"
        },
        "bodies": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/astronomyBody"
          }
        }
      }
    },
    "dignity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sign_status",
        "relationship_basis",
        "exact_exaltation_distance_deg"
      ],
      "properties": {
        "sign_status": {
          "enum": [
            "exalted",
            "own",
            "great_friend",
            "friend",
            "neutral",
            "enemy",
            "great_enemy",
            "debilitated",
            "not_applicable",
            "not_evaluated"
          ]
        },
        "relationship_basis": {
          "enum": [
            "natural",
            "compound",
            "not_applicable",
            "not_evaluated"
          ]
        },
        "exact_exaltation_distance_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 180
        }
      }
    },
    "nakshatra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "index",
        "pada",
        "lord",
        "deity"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 26
        },
        "pada": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "lord": {
          "$ref": "#/$defs/bodyName"
        },
        "deity": {
          "type": "string"
        }
      }
    },
    "d1Graha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "longitude_deg",
        "sign",
        "degree_in_sign",
        "house",
        "retrograde",
        "houses_owned",
        "lordship_tags",
        "functional_nature",
        "yogakaraka",
        "dignity",
        "direct_dispositor",
        "nakshatra",
        "sensitivity",
        "sensitivity_reasons"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/bodyName"
        },
        "longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "sign": {
          "$ref": "#/$defs/sign"
        },
        "degree_in_sign": {
          "$ref": "#/$defs/degreeInSign"
        },
        "house": {
          "$ref": "#/$defs/house"
        },
        "retrograde": {
          "type": "boolean"
        },
        "houses_owned": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/house"
          },
          "uniqueItems": true
        },
        "lordship_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "functional_nature": {
          "type": "object",
          "required": [
            "benefic_sources",
            "difficult_sources",
            "mixed"
          ],
          "properties": {
            "benefic_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "difficult_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mixed": {
              "type": "boolean"
            }
          }
        },
        "yogakaraka": {
          "type": "boolean"
        },
        "dignity": {
          "$ref": "#/$defs/dignity"
        },
        "direct_dispositor": {
          "$ref": "#/$defs/classicalBodyName"
        },
        "combustion": {
          "enum": [
            "not_evaluated",
            "combust",
            "not_combust"
          ]
        },
        "nakshatra": {
          "$ref": "#/$defs/nakshatra"
        },
        "vargottama": {
          "type": "boolean"
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "sensitivity_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "vargaGraha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "source_longitude_deg",
        "segment_index",
        "longitude_deg",
        "sign",
        "degree_in_sign",
        "house",
        "dignity",
        "vargottama",
        "sensitivity",
        "sensitivity_reasons"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/bodyName"
        },
        "source_longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0
        },
        "longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "sign": {
          "$ref": "#/$defs/sign"
        },
        "degree_in_sign": {
          "$ref": "#/$defs/degreeInSign"
        },
        "house": {
          "$ref": "#/$defs/house"
        },
        "dignity": {
          "$ref": "#/$defs/dignity"
        },
        "vargottama": {
          "type": "boolean"
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "sensitivity_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "chartAscendant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longitude_deg",
        "sign",
        "degree_in_sign",
        "sensitivity"
      ],
      "properties": {
        "longitude_deg": {
          "$ref": "#/$defs/longitude"
        },
        "sign": {
          "$ref": "#/$defs/sign"
        },
        "degree_in_sign": {
          "$ref": "#/$defs/degreeInSign"
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        }
      }
    },
    "d1Chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "varga",
        "mapping_policy_id",
        "ascendant",
        "grahas"
      ],
      "properties": {
        "varga": {
          "const": "D1"
        },
        "mapping_policy_id": {
          "type": "string"
        },
        "ascendant": {
          "$ref": "#/$defs/chartAscendant"
        },
        "grahas": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/d1Graha"
          }
        }
      }
    },
    "vargaChart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "varga",
        "mapping_policy_id",
        "ascendant",
        "grahas"
      ],
      "properties": {
        "varga": {
          "enum": [
            "D9",
            "D10"
          ]
        },
        "mapping_policy_id": {
          "type": "string"
        },
        "ascendant": {
          "$ref": "#/$defs/chartAscendant"
        },
        "grahas": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/vargaGraha"
          }
        }
      }
    },
    "moonLagna": {
      "type": "object",
      "required": [
        "moon_sign",
        "body_houses",
        "sensitivity"
      ],
      "properties": {
        "moon_sign": {
          "$ref": "#/$defs/sign"
        },
        "body_houses": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/house"
          }
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        }
      }
    },
    "arudhaLagna": {
      "type": "object",
      "required": [
        "lagna_lord",
        "count",
        "provisional_sign",
        "exception_applied",
        "final_sign",
        "sensitivity"
      ],
      "properties": {
        "lagna_lord": {
          "$ref": "#/$defs/classicalBodyName"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "provisional_sign": {
          "$ref": "#/$defs/sign"
        },
        "exception_applied": {
          "type": "boolean"
        },
        "final_sign": {
          "$ref": "#/$defs/sign"
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        }
      }
    },
    "dispositorPath": {
      "type": "object",
      "required": [
        "body",
        "direct_dispositor",
        "chain",
        "termination"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/bodyName"
        },
        "direct_dispositor": {
          "$ref": "#/$defs/classicalBodyName"
        },
        "chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classicalBodyName"
          }
        },
        "termination": {
          "type": "object",
          "required": [
            "type",
            "members"
          ],
          "properties": {
            "type": {
              "enum": [
                "self",
                "cycle"
              ]
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/classicalBodyName"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "conjunction": {
      "type": "object",
      "required": [
        "relation_id",
        "bodies",
        "sign",
        "associated",
        "same_sign",
        "angular_separation_deg"
      ],
      "properties": {
        "relation_id": {
          "type": "string"
        },
        "bodies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bodyName"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "sign": {
          "$ref": "#/$defs/sign"
        },
        "associated": {
          "const": true
        },
        "same_sign": {
          "const": true
        },
        "angular_separation_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "aspect": {
      "type": "object",
      "required": [
        "relation_id",
        "source_body",
        "offset",
        "target_sign",
        "target_house",
        "target_bodies"
      ],
      "properties": {
        "relation_id": {
          "type": "string"
        },
        "source_body": {
          "$ref": "#/$defs/classicalBodyName"
        },
        "offset": {
          "type": "integer",
          "enum": [
            3,
            4,
            5,
            7,
            8,
            9,
            10
          ]
        },
        "target_sign": {
          "$ref": "#/$defs/sign"
        },
        "target_house": {
          "$ref": "#/$defs/house"
        },
        "target_bodies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bodyName"
          },
          "uniqueItems": true
        }
      }
    },
    "exchange": {
      "type": "object",
      "required": [
        "relation_id",
        "type",
        "bodies",
        "evidence_ids"
      ],
      "properties": {
        "relation_id": {
          "type": "string"
        },
        "type": {
          "const": "parivartana"
        },
        "bodies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classicalBodyName"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        }
      }
    },
    "vimshottari": {
      "type": "object",
      "required": [
        "status",
        "moon_nakshatra",
        "birth_lord",
        "fraction_remaining",
        "nominal_year_policy",
        "periods"
      ],
      "properties": {
        "status": {
          "enum": [
            "proportions_only",
            "canonical_dates"
          ]
        },
        "moon_nakshatra": {
          "type": "string"
        },
        "birth_lord": {
          "$ref": "#/$defs/bodyName"
        },
        "fraction_remaining": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nominal_year_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "periods": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "pattern": {
      "type": "object",
      "required": [
        "pattern_id",
        "rule_id",
